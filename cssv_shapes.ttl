@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix cssv: <http://data.europa.eu/2sa/cssv#> .

cssv:CSSVShapes a owl:Ontology ;
	a owl:Ontology ;
	rdfs:label "CSSV a-box SHACL shapes to validate Specifications."@en ;
	rdfs:comment "CSSV a-box SHACL shapes to validate Specifications."@en ;
	dct:modified "2025-11-03" ;
	owl:versionInfo "v1.0.0"@en .
    
#################################################################
# cssv:SpecificationShape
#################################################################
cssv:SpecificationShape a sh:NodeShape ;
    sh:targetClass cssv:Specification ;
    rdfs:label "Specification Shape"@en ;

    #################################################################
    ## Minimum required properties
    #################################################################

    sh:property [
        sh:path dct:title ;
        sh:minCount 1 ;
        sh:message "A cssv:Specification must have at least one dct:title."@en ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path cssv:isMaintainedBy ;
        sh:minCount 1 ;
        sh:message "A cssv:Specification must specify cssv:isMaintainedBy."@en ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path dcat:distribution ;
        sh:minCount 1 ;
        sh:message "A cssv:Specification must have at least one dcat:distribution."@en ;
        sh:severity sh:Violation ;
    ] ;

    #################################################################
    ## Range/domain constraints for properties
    #################################################################

    sh:property [
        sh:path cssv:isMaintainedBy ;
        sh:class org:Organization ;
        sh:message "cssv:isMaintainedBy must point to an org:Organization."@en ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path cssv:isRecommendedBy ;
        sh:class org:Organization ;
        sh:message "cssv:isRecommendedBy must point to an foaf:Agent."@en ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path cssv:combinedIn ;
        sh:class cssv:Family ;
        sh:message "cssv:combinedIn must point to a cssv:Family."@en ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path cssv:configuredIn ;
        sh:class cssv:ApplicationProfile ;
        sh:message "cssv:configuredIn must point to a cssv:ApplicationProfile."@en ;
        sh:severity sh:Violation ;
    ] ;

    #################################################################
    ## Inverse constraints
    #################################################################

    sh:property [
        sh:path cssv:combinedIn ;
        sh:message "Inverse violation: Each Family that a Specification is combinedIn must combine the Specification."@en ;
        sh:sparql [
            sh:select """
                SELECT $this ?family WHERE {
                    $this cssv:combinedIn ?family .
                    FILTER NOT EXISTS { ?family cssv:combines $this }
                }
            """ ;
        ] ;
    ] ;

    sh:property [
        sh:path cssv:configuredIn ;
        sh:message "Inverse violation: Each AP that a Specification is configuredIn must cssv:configures the Specification."@en ;
        sh:sparql [
            sh:select """
                SELECT $this ?ap WHERE {
                    $this cssv:configuredIn ?ap .
                    FILTER NOT EXISTS { ?ap cssv:configures $this }
                }
            """ ;
        ] ;
    ] ;

    #################################################################
    ## Distribution must have dcat:accessURL
    #################################################################

    sh:sparql [
        sh:message "Each dcat:distribution must include a dcat:accessURL." ;
        sh:select """
            SELECT $this ?distribution WHERE {
                $this dcat:distribution ?distribution .
                FILTER NOT EXISTS { ?distribution dcat:accessURL ?url }
            }
        """ ;
    ] ;

    #################################################################
    ## Maintainer must have skos:prefLabel
    #################################################################

    sh:sparql [
        sh:message "The organisation in cssv:isMaintainedBy must have a skos:prefLabel." ;
        sh:select """
            SELECT $this ?org WHERE {
                $this cssv:isMaintainedBy ?org .
                FILTER NOT EXISTS { ?org skos:prefLabel ?label }
            }
        """ ;
    ] .

#################################################################
# cssv:ApplicationProfileShape
#################################################################
cssv:ApplicationProfileShape a sh:NodeShape ;
    sh:targetClass cssv:ApplicationProfile ;
    rdfs:label "Application Profile Shape"@en ;
    sh:severity sh:Info ;

    sh:property [
        sh:path cssv:configures ;
        sh:class cssv:Specification ;
        sh:message "cssv:configures must point to a cssv:Specification."@en ;
        sh:severity sh:Violation ;
    ] ;

    # Disjointness: cannot be Standard or Family
    sh:not [
        sh:class cssv:Standard ;
        sh:message "An ApplicationProfile cannot be a cssv:Standard."@en ;
        sh:severity sh:Warning ;
    ] ;

    sh:not [
        sh:class cssv:Family ;
        sh:message "An ApplicationProfile cannot be a cssv:Family."@en ;
        sh:severity sh:Warning ;
    ] .

#################################################################
# cssv:FamilyShape
#################################################################
cssv:StandardShape a sh:NodeShape ;
    sh:targetClass cssv:Standard ;
    rdfs:label "Standard Shape"@en ;
    sh:severity sh:Info ;

    # Disjoint with AP and Family
    sh:not [
        sh:class cssv:ApplicationProfile ;
        sh:message "A Standard cannot be a cssv:ApplicationProfile."@en ;
        sh:severity sh:Warning ;
    ] ;

    sh:not [
        sh:class cssv:Family ;
        sh:message "A Standard cannot be a cssv:Family."@en ;
        sh:severity sh:Warning ;
    ] .

#################################################################
# cssv:StandardShape
#################################################################
cssv:StandardShape a sh:NodeShape ;
    sh:targetClass cssv:Standard ;
    rdfs:label "Standard Shape"@en ;
    sh:severity sh:Info ;

    # Disjoint with AP and Family
    sh:not [
        sh:class cssv:ApplicationProfile ;
        sh:message "A Standard cannot be a cssv:ApplicationProfile."@en ;
        sh:severity sh:Warning ;
    ] ;

    sh:not [
        sh:class cssv:Family ;
        sh:message "A Standard cannot be a cssv:Family."@en ;
        sh:severity sh:Warning ;
    ] .